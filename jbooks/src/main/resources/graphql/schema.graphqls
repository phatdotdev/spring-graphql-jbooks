# Operation Types (Query, Mutation, Subscription)
type Query {
    books: [Book!]!
    book(id: ID): Book!
    search(text: String): [SearchItem]!
    authors: [Author!]!
    review(id: ID): Review
    reviews(filter: ReviewFilter): [Review]!
}

type Mutation {
    addBook(bookInput: BookInput): Book!
}

# Object Types
type Book {
    id: ID!
    title: String!
    author: Author
}

type Author {
    id: ID!
    name: String!
    books: [Book!]!
}

type Review {
    id: ID!
    rating: Int!
    comment: String
    createdAt: String!
    reviewerName: String!
    verified: Boolean!
    book: Book!
}

# Input
input BookInput {
    title: String!
    authorId: Int!
}

input ReviewFilter {
    rating: Int
    verified: Boolean
    reviewerName: String
}

union SearchItem = Author | Book